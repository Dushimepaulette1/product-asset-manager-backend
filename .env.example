# Copy this file to .env and replace every value before running "docker compose up".
# .env is gitignored. Never commit real values.

# Host ports
API_PORT=8080
SQL_PORT=14333
SERVICEBUS_PORT=5672
SERVICEBUS_MANAGEMENT_PORT=5300
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# SQL Server "sa" password. SQL Server requires at least 8 characters with
# upper case, lower case, a digit and a symbol, or the container will not start.
SQL_SA_PASSWORD=Replace_Me_Sql_123!

# Key used to sign login tokens. Use a long random string (32+ characters).
JWT_SIGNING_KEY=replace-me-with-a-long-random-string-of-32-plus-characters

# Admin account created on first start
SEED_ADMIN_EMAIL=admin@local.dev
SEED_ADMIN_PASSWORD=Replace_Me_Admin_1!

# Share of traces to keep, from 0 to 1. 1.0 keeps every trace (right for local use);
# a busy production system would use something like 0.1.
TRACE_SAMPLING_RATIO=1.0
